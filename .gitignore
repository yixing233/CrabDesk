# Build outputs
**/bin/
**/obj/
artifacts/
TestResults/

# Local development scratch output (dev-run dumps, WinUI verification)
build/dev-run-*
build/obj-winui/
build/verify-winui/
build/desktop-current*.png

# IDE and user state
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user

# Local runtime state
config.json
config.json.bak
config.json.tmp
desktop-visibility.lock
Backups/

# Signing material and local secrets
*.pfx
*.p12
*.snk
*.key
*.pem
*.cer
*.crt
.env
.env.*
!.env.example

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Local scratch that must never reach the repository.
# %SystemDrive% is created when a script fails to expand the environment
# variable, and the .backup file is another desktop tool's binary state.
%SystemDrive%/
*.backup
.todo/
.zcode/
