<Page
    x:Class="CrabDesk.WinUI.Views.SmartOrganizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CrabDesk.WinUI.Views"
    NavigationCacheMode="Enabled">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <SelectorBar x:Name="PageSelectorBar"
                     SelectionChanged="PageSelectorBar_SelectionChanged"
                     HorizontalAlignment="Left">
            <SelectorBarItem Text="普通规则" Tag="rules" IsSelected="True" AutomationProperties.Name="普通规则" />
            <SelectorBarItem Text="AI 整理" Tag="ai" AutomationProperties.Name="AI 整理" />
        </SelectorBar>
        <Frame x:Name="ContentFrame" Grid.Row="1" />
    </Grid>
</Page>
