<Page
    x:Class="CrabDesk.WinUI.Views.WidgetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:icons="using:CrabDesk.WinUI.Controls">
    <Page.Resources>
    <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Light"><x:Double x:Key="EditorThumbOpacity">0.45</x:Double><x:Double x:Key="EditorThumbHoverOpacity">0.8</x:Double></ResourceDictionary>
            <ResourceDictionary x:Key="Dark"><x:Double x:Key="EditorThumbOpacity">0.45</x:Double><x:Double x:Key="EditorThumbHoverOpacity">0.8</x:Double></ResourceDictionary>
            <ResourceDictionary x:Key="HighContrast"><x:Double x:Key="EditorThumbOpacity">1</x:Double><x:Double x:Key="EditorThumbHoverOpacity">1</x:Double></ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <CornerRadius x:Key="GridViewItemCornerRadius">12</CornerRadius>
        <ControlTemplate x:Key="EditorScrollTrackButton" TargetType="primitives:RepeatButton">
            <Grid Background="Transparent" />
        </ControlTemplate>
        <Style x:Key="EditorScrollBarStyle" TargetType="primitives:ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:ScrollBar">
                        <Grid x:Name="VerticalRoot" Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <primitives:RepeatButton x:Name="VerticalSmallDecrease" Visibility="Collapsed" />
                            <primitives:RepeatButton x:Name="VerticalLargeDecrease" Grid.Row="1" Height="0" IsTabStop="False"
                                AllowFocusOnInteraction="False" Template="{StaticResource EditorScrollTrackButton}" />
                            <primitives:Thumb x:Name="VerticalThumb" Grid.Row="2" MinHeight="32">
                                <primitives:Thumb.Template>
                                    <ControlTemplate TargetType="primitives:Thumb">
                                        <Grid Background="Transparent">
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal" />
                                                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="ThumbFill.Opacity" Value="{ThemeResource EditorThumbHoverOpacity}" /></VisualState.Setters></VisualState>
                                                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="ThumbFill.Opacity" Value="1" /></VisualState.Setters></VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                            <Border x:Name="ThumbFill" Width="4" CornerRadius="2" Background="{ThemeResource SecondaryTextBrush}" Opacity="{ThemeResource EditorThumbOpacity}" />
                                        </Grid>
                                    </ControlTemplate>
                                </primitives:Thumb.Template>
                            </primitives:Thumb>
                            <primitives:RepeatButton x:Name="VerticalLargeIncrease" Grid.Row="3" IsTabStop="False"
                                AllowFocusOnInteraction="False" Template="{StaticResource EditorScrollTrackButton}" />
                            <primitives:RepeatButton x:Name="VerticalSmallIncrease" Grid.Row="4" Visibility="Collapsed" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorScrollStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="ScrollContentPresenter" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}" />
                            <primitives:ScrollBar x:Name="VerticalScrollBar" Grid.Column="1" Margin="0,8" Orientation="Vertical"
                                Style="{StaticResource EditorScrollBarStyle}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                Maximum="{TemplateBinding ScrollableHeight}" Value="{TemplateBinding VerticalOffset}" ViewportSize="{TemplateBinding ViewportHeight}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WidgetTileStyle" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
        <DataTemplate x:Key="WidgetTileTemplate">
            <Grid>
            <Border Background="{ThemeResource SectionSurfaceBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="12">
                <StackPanel Spacing="10">
                    <Grid Height="156">
                        <icons:WidgetPreview Widget="{Binding Widget}" PreviewAppearance="{Binding Appearance}" PreviewRevision="{Binding PreviewRevision}" />
                        <Border Visibility="{Binding StatusVisibility}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                Background="{ThemeResource SectionSurfaceBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="8,4">
                            <TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Border>
                    </Grid>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Caption}" Style="{StaticResource SecondaryBodyStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding ActionLabel}" Foreground="{ThemeResource AccentBrush}" FontSize="12" />
                        <icons:LucideIcon Icon="{Binding ActionIcon}" FontSize="14" Foreground="{ThemeResource AccentBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border BorderBrush="{ThemeResource AccentBrush}" BorderThickness="2" CornerRadius="12" IsHitTestVisible="False"
                    Visibility="{Binding SelectionVisibility}" />
            </Grid>
        </DataTemplate>
    </ResourceDictionary>
    </Page.Resources>
    <Grid>
    <SplitView x:Name="EditorHost" Margin="24,8,24,24" PanePlacement="Right" DisplayMode="Overlay"
               OpenPaneLength="340" PaneBackground="Transparent" SizeChanged="EditorHost_SizeChanged" PaneClosed="EditorHost_PaneClosed">
        <SplitView.Content>
            <Grid x:Name="OverviewView" RowSpacing="16">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <SelectorBar x:Name="GalleryTabs" SelectionChanged="GalleryTabs_SelectionChanged">
                    <SelectorBarItem x:Name="MyWidgetsTab" Text="我的组件" IsSelected="True" />
                    <SelectorBarItem x:Name="AddWidgetsTab" Text="添加组件" />
                </SelectorBar>
                <TextBlock x:Name="GalleryCaption" Grid.Row="1" Style="{StaticResource SecondaryBodyStyle}" />
                <GridView x:Name="WidgetGallery" Grid.Row="2" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="WidgetGallery_ItemClick"
                          ItemTemplate="{StaticResource WidgetTileTemplate}" ItemContainerStyle="{StaticResource WidgetTileStyle}"
                          SizeChanged="WidgetGallery_SizeChanged" HorizontalAlignment="Stretch"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="240" /></ItemsPanelTemplate></GridView.ItemsPanel>
                </GridView>
                <Border x:Name="EmptyState" Grid.Row="2" Style="{StaticResource SectionCardStyle}" Visibility="Collapsed" VerticalAlignment="Top">
                    <StackPanel Spacing="12" HorizontalAlignment="Center" Padding="20">
                        <icons:LucideIcon Icon="PanelsTopLeft" FontSize="32" HorizontalAlignment="Center" Foreground="{ThemeResource AccentBrush}" />
                        <TextBlock Text="桌面还没有组件" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="浏览预览卡片，挑选你需要的内容。" Style="{StaticResource SecondaryBodyStyle}" />
                        <Button Content="添加组件" Click="BrowseWidgets_Click" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </SplitView.Content>
        <SplitView.Pane>
        <Border x:Name="EditorPane" Background="{ThemeResource SectionSurfaceBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}"
                BorderThickness="1" CornerRadius="12">
            <Grid x:Name="EditorView" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid x:Name="EditorHeader" Margin="16" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="EditorName" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="更改自动保存" Style="{StaticResource SecondaryBodyStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="BackToGallery_Click" AutomationProperties.Name="关闭组件编辑" ToolTipService.ToolTip="关闭编辑" Padding="7" VerticalAlignment="Top">
                        <icons:LucideIcon Icon="X" FontSize="16" />
                    </Button>
                </Grid>
                <ScrollViewer x:Name="EditorScroll" Grid.Row="1" Style="{StaticResource EditorScrollStyle}" Margin="0,0,4,0" Padding="16,0,4,16"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" ZoomMode="Disabled">
                <StackPanel Spacing="20">
                    <StackPanel x:Name="ClockEditor" Visibility="Collapsed" Spacing="16">
                        <TextBlock Text="时间显示" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="24 小时制" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="Use24Hour" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="ClockOption_Toggled" AutomationProperties.Name="24 小时制" />
                        </Grid>
                        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="显示秒" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="Seconds" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="ClockOption_Toggled" AutomationProperties.Name="显示秒" />
                        </Grid>
                    </StackPanel>
                    <TextBlock x:Name="CalendarHelp" Visibility="Collapsed" Text="在桌面月历中使用左右箭头切换月份，点击“今”返回本月。日期以周一开始，今天会高亮显示。" Style="{StaticResource SecondaryBodyStyle}" />
                    <TextBlock x:Name="NoteHelp" Visibility="Collapsed" Text="点击桌面便签正文即可编辑，内容自动保存。Enter 换行，Esc 或点击其他区域结束编辑；滚动可阅读长便签。" Style="{StaticResource SecondaryBodyStyle}" />
                    <StackPanel x:Name="TodoEditor" Visibility="Collapsed" Spacing="10">
                        <TextBlock Text="待办清单" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="NewTaskInput" PlaceholderText="添加一项待办，按 Enter 确认" MaxLength="500" KeyDown="NewTaskInput_KeyDown" AutomationProperties.Name="新待办内容" />
                            <Button Grid.Column="1" Content="添加" Click="AddTask_Click" />
                        </Grid>
                        <StackPanel x:Name="TaskRows" Spacing="8" />
                        <TextBlock Text="桌面卡片可直接添加、编辑和勾选待办，滚动可查看其余事项。" Style="{StaticResource SecondaryBodyStyle}" />
                    </StackPanel>
                    <StackPanel x:Name="TranslationEditor" Visibility="Collapsed" Spacing="16">
                        <TextBlock Text="AI 接口" FontWeight="SemiBold" />
                        <TextBox x:Name="TranslationBaseUrl" Header="接口地址" PlaceholderText="https://api.example.com/v1" TextChanged="TranslationSettings_TextChanged" />
                        <PasswordBox x:Name="TranslationApiKey" Header="API Key" PlaceholderText="本地模型可留空" PasswordChanged="TranslationApiKey_PasswordChanged" />
                        <TextBox x:Name="TranslationModel" Header="模型" PlaceholderText="输入模型名称" TextChanged="TranslationSettings_TextChanged" />
                        <TextBlock Text="支持 OpenAI 兼容接口。点击桌面卡片输入原文，选择目标语言后点击“翻译”或按 Ctrl+Enter。" Style="{StaticResource SecondaryBodyStyle}" />
                    </StackPanel>
                    <StackPanel x:Name="WeatherEditor" Visibility="Collapsed" Spacing="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="城市管理" FontWeight="SemiBold" />
                            <StackPanel Spacing="8">
                                <TextBlock Text="桌面显示城市" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" />
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="SavedCities" PlaceholderText="添加一个城市" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" SelectionChanged="SavedCities_SelectionChanged" AutomationProperties.Name="桌面显示城市" />
                                    <Button x:Name="RemoveCityButton" Grid.Column="1" Padding="8,0" Click="RemoveCity_Click" AutomationProperties.Name="移除当前城市" ToolTipService.ToolTip="移除当前城市">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                            <AutoSuggestBox x:Name="CityQuery" Header="添加城市" PlaceholderText="输入城市名，按 Enter 搜索" QueryIcon="Find"
                                            TextMemberPath="Name" QuerySubmitted="CityQuery_QuerySubmitted" TextChanged="CityQuery_TextChanged" />
                            <TextBlock x:Name="CitySearchStatus" Style="{StaticResource SecondaryBodyStyle}"
                                       Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                            <Button x:Name="LocateCityButton" Content="使用当前位置" Click="LocateCity_Click" HorizontalAlignment="Left" ToolTipService.ToolTip="仅在点击时获取 Windows 系统位置" />
                            <HyperlinkButton x:Name="LocationSettings" Content="打开系统定位设置" NavigateUri="ms-settings:privacy-location" Padding="0" HorizontalAlignment="Left" Visibility="Collapsed" />
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource SubtleBorderBrush}" />
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="天气状态" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button x:Name="RefreshWeatherButton" Grid.Column="1" Padding="8,0" Click="RefreshWeather_Click" ToolTipService.ToolTip="刷新天气" AutomationProperties.Name="刷新天气">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                            </Grid>
                            <TextBlock x:Name="CurrentCity" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="WeatherDetails" Style="{StaticResource SecondaryBodyStyle}" />
                            <HyperlinkButton x:Name="WeatherSource" Content="数据来自小米天气" FontSize="12" NavigateUri="https://privacy.mi.com/weather/zh_CN/" Padding="0" HorizontalAlignment="Left" ToolTipService.ToolTip="每 30 分钟更新；刷新失败时保留已有天气数据" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="OperationStatus" Style="{StaticResource SecondaryBodyStyle}"
                               Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                    <Expander x:Name="CardSettings" Header="卡片设置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                        <StackPanel Spacing="12">
                            <TextBox x:Name="TitleInput" Header="卡片名称" PlaceholderText="使用组件默认名称" MaxLength="80" TextChanged="TitleInput_TextChanged" />
                            <ComboBox x:Name="SizePicker" Header="尺寸" SelectionChanged="SizePicker_SelectionChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="组件尺寸" />
                            <ComboBox x:Name="MonitorPicker" Header="显示器" DisplayMemberPath="Label" SelectionChanged="MonitorPicker_SelectionChanged" HorizontalAlignment="Stretch" />
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="锁定位置" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="PositionLock" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="PositionLock_Toggled" AutomationProperties.Name="锁定组件位置" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                </ScrollViewer>
                <Border x:Name="EditorFooter" Grid.Row="2" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                    <Button Content="移除组件" Click="RemoveWidget_Click" HorizontalAlignment="Left" Foreground="{ThemeResource DangerBrush}" />
                </Border>
            </Grid>
        </Border>
        </SplitView.Pane>
    </SplitView>
    <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Error" VerticalAlignment="Bottom" Margin="24,0,24,16"
             Visibility="{Binding IsOpen, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</Page>
