<Page
    x:Class="CrabDesk.WinUI.Views.WidgetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:icons="using:CrabDesk.WinUI.Controls">
    <Page.Resources>
    <ResourceDictionary>
        <CornerRadius x:Key="GridViewItemCornerRadius">12</CornerRadius>
        <Style x:Key="WidgetTileStyle" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
        <DataTemplate x:Key="WidgetTileTemplate">
            <Grid>
            <Border Background="{ThemeResource SectionSurfaceBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="12">
                <StackPanel Spacing="10">
                    <Grid Height="156">
                        <icons:WidgetPreview Widget="{Binding Widget}" IsCatalogPreview="{Binding IsCatalog}" PreviewAppearance="{Binding Appearance}" PreviewRevision="{Binding PreviewRevision}" />
                        <Border Visibility="{Binding StatusVisibility}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                Background="{ThemeResource SectionSurfaceBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="8,4">
                            <TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Border>
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <icons:WidgetColorIcon AssetName="{Binding IconAssetName}" Width="32" Height="32" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Caption}" Style="{StaticResource SecondaryBodyStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding ActionLabel}" Foreground="{ThemeResource AccentBrush}" FontSize="12" />
                        <icons:TablerIcon Icon="{Binding ActionIcon}" FontSize="14" Foreground="{ThemeResource AccentBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border BorderBrush="{ThemeResource AccentBrush}" BorderThickness="2" CornerRadius="12" IsHitTestVisible="False"
                    Visibility="{Binding SelectionVisibility}" />
            </Grid>
        </DataTemplate>
    </ResourceDictionary>
    </Page.Resources>
    <Grid>
    <Grid Margin="24,8,24,24" RowSpacing="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="WidgetPageBack" Click="WidgetPageBack_Click" Visibility="Collapsed" VerticalAlignment="Center"
                    AutomationProperties.Name="返回小组件" ToolTipService.ToolTip="返回">
                <icons:TablerIcon Icon="ArrowLeft" FontSize="18" />
            </Button>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Name="WidgetPageTitle" Text="小组件" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="WidgetPageSubtitle" Text="添加组件，让桌面更顺手。" Style="{StaticResource SecondaryBodyStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="WidgetAppearanceButton" Grid.Column="2" Click="WidgetAppearanceButton_Click"
                    VerticalAlignment="Center" AutomationProperties.Name="组件外观设置">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:TablerIcon Icon="Settings" FontSize="16" />
                    <TextBlock Text="外观设置" />
                </StackPanel>
            </Button>
        </Grid>
        <Grid Grid.Row="1">
            <Grid x:Name="OverviewView" RowSpacing="16">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border x:Name="WidgetCenterCard" Style="{StaticResource SectionCardStyle}" Margin="0,0,12,0">
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <icons:TablerIcon Icon="LayoutDashboard" FontSize="24" VerticalAlignment="Center" Foreground="{ThemeResource AccentBrush}" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="组件中心" FontWeight="SemiBold" />
                                <TextBlock Text="将组件集中在悬浮面板，开启后单击托盘图标打开" Style="{StaticResource SecondaryBodyStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <ToggleSwitch x:Name="WidgetCenterEnabledToggle" Grid.Column="1" Style="{StaticResource CompactToggleSwitchStyle}"
                                      IsOn="False" Toggled="WidgetCenterEnabled_Toggled" VerticalAlignment="Center" AutomationProperties.Name="启用组件中心" />
                        <TextBlock x:Name="WidgetCenterStatus" Grid.Row="1" Style="{StaticResource SecondaryBodyStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button x:Name="OpenWidgetCenterButton" Grid.Row="1" Grid.Column="1" Content="打开" IsEnabled="False"
                                Click="OpenWidgetCenter_Click" AutomationProperties.Name="打开组件中心" />
                    </Grid>
                </Border>
                <Grid x:Name="GalleryToolbar" Grid.Row="1" ColumnSpacing="12" Margin="0,0,12,0" SizeChanged="GalleryToolbar_SizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <AutoSuggestBox x:Name="WidgetSearch" Header="搜索组件" PlaceholderText="搜索名称或功能"
                                    QueryIcon="Find" TextChanged="WidgetSearch_TextChanged"
                                    AutomationProperties.Name="搜索组件" />
                    <ComboBox x:Name="WidgetFilter" Grid.Column="1" Header="组件筛选" Width="160"
                              SelectedIndex="0" SelectionChanged="WidgetFilter_SelectionChanged"
                              AutomationProperties.Name="组件筛选">
                        <ComboBoxItem Content="全部" />
                        <ComboBoxItem Content="已添加" />
                        <ComboBoxItem Content="未添加" />
                    </ComboBox>
                </Grid>
                <TextBlock x:Name="GalleryCaption" Grid.Row="2" Style="{StaticResource SecondaryBodyStyle}" />
                <GridView x:Name="WidgetGallery" Grid.Row="3" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="WidgetGallery_ItemClick"
                          ItemTemplate="{StaticResource WidgetTileTemplate}" ItemContainerStyle="{StaticResource WidgetTileStyle}"
                          SizeChanged="WidgetGallery_SizeChanged" HorizontalAlignment="Stretch"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="240" /></ItemsPanelTemplate></GridView.ItemsPanel>
                </GridView>
                    <StackPanel x:Name="EmptyState" Grid.Row="3" Visibility="Collapsed" Spacing="12"
                                HorizontalAlignment="Center" VerticalAlignment="Top" Padding="20" Margin="0,32,12,0">
                        <icons:TablerIcon Icon="LayoutDashboard" FontSize="32" HorizontalAlignment="Center" Foreground="{ThemeResource AccentBrush}" />
                        <TextBlock x:Name="EmptyStateTitle" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                        <Button Content="显示全部组件" Click="ClearGalleryFilters_Click" HorizontalAlignment="Center" />
                    </StackPanel>
            </Grid>
            <Grid x:Name="EditorView" Visibility="Collapsed" ColumnSpacing="24" RowSpacing="20" SizeChanged="EditorView_SizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="EditorPreviewColumn" Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border x:Name="EditorPreviewPane" VerticalAlignment="Top" Padding="16" CornerRadius="12"
                        Background="{ThemeResource SectionSurfaceBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock x:Name="EditorPreviewTitle" Text="组件预览" FontWeight="SemiBold" />
                        <icons:WidgetPreview x:Name="EditorPreview" Height="230" />
                        <StackPanel x:Name="EditorPreviewMetadata" Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <icons:WidgetColorIcon x:Name="EditorIcon" Width="24" Height="24" VerticalAlignment="Center" />
                                <TextBlock x:Name="EditorName" Grid.Column="1" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="更改自动保存" Style="{StaticResource SecondaryBodyStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <ScrollViewer x:Name="EditorScroll" Grid.Column="1" Grid.RowSpan="2" Padding="0,0,12,16" IsTabStop="False"
                              VerticalScrollMode="Enabled" HorizontalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" ZoomMode="Disabled">
                <StackPanel Spacing="20">
                    <Border x:Name="WidgetPlacementSettings" Style="{StaticResource SectionCardStyle}">
                        <StackPanel Spacing="12">
                            <ComboBox x:Name="WidgetPlacementPicker" Header="组件位置" HorizontalAlignment="Stretch"
                                      SelectionChanged="WidgetPlacementPicker_SelectionChanged" AutomationProperties.Name="组件位置">
                                <ComboBoxItem Content="桌面" Tag="Desktop" />
                                <ComboBoxItem x:Name="WidgetCenterPlacementOption" Content="组件中心" Tag="Center" />
                            </ComboBox>
                            <TextBlock x:Name="WidgetPlacementHint" Style="{StaticResource SecondaryBodyStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="LyricsEditor" Visibility="Collapsed" Spacing="14">
                        <TextBlock Text="组件尺寸" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <NumberBox x:Name="LyricsWidth" Header="宽度（DIP）" Minimum="180" SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Compact" AutomationProperties.Name="歌词组件宽度" />
                            <NumberBox x:Name="LyricsHeight" Grid.Column="1" Header="高度（DIP）" Minimum="120" SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Compact" AutomationProperties.Name="歌词组件高度" />
                        </Grid>
                        <Button Content="应用宽高" Click="ApplyLyricsSize_Click" HorizontalAlignment="Left" />
                        <TextBlock Text="拖动桌面组件的边缘或角落，也可自由调整宽高。" Style="{StaticResource SecondaryBodyStyle}" />
                        <TextBlock Text="歌词显示" FontWeight="SemiBold" />
                        <ComboBox x:Name="LyricsFontFamily" Header="字体" HorizontalAlignment="Stretch" SelectionChanged="LyricsTypography_SelectionChanged" />
                        <ComboBox x:Name="LyricsFontStyle" Header="字形" HorizontalAlignment="Stretch" SelectionChanged="LyricsTypography_SelectionChanged">
                            <ComboBoxItem Content="常规" /><ComboBoxItem Content="斜体" />
                        </ComboBox>
                        <ComboBox x:Name="LyricsFontWeight" Header="字重" HorizontalAlignment="Stretch" SelectionChanged="LyricsTypography_SelectionChanged" />
                        <NumberBox x:Name="LyricsFont" Header="当前行字号" Minimum="14" Maximum="48" SmallChange="2" SpinButtonPlacementMode="Inline" ValueChanged="LyricsNumber_ValueChanged" />
                        <Slider x:Name="LyricsSpacing" Header="行间距（1.75 倍）" Minimum="1" Maximum="3" Value="1.75"
                                StepFrequency="0.05" SmallChange="0.05" LargeChange="0.25" IsThumbToolTipEnabled="False"
                                ValueChanged="LyricsSpacing_ValueChanged" AutomationProperties.Name="歌词行间距（倍）" />
                        <TextBlock Text="行间距相对于当前行字号，显示行数随组件高度自动调整。" Style="{StaticResource SecondaryBodyStyle}" />
                        <ComboBox x:Name="LyricsInk" Header="文字颜色" HorizontalAlignment="Stretch" SelectionChanged="LyricsInk_SelectionChanged">
                            <ComboBoxItem Content="自动" /><ComboBoxItem Content="浅色" /><ComboBoxItem Content="深色" />
                        </ComboBox>
                        <TextBlock x:Name="WidgetCenterLyricsMaterialHint" Text="中心使用实色背景，背景与文字配色跟随组件中心主题。"
                                   Visibility="Collapsed" Style="{StaticResource SecondaryBodyStyle}" TextWrapping="Wrap" />
                        <ToggleSwitch x:Name="LyricsTransparentBackground" Header="背景模式" OnContent="透明" OffContent="亚克力" Toggled="LyricsTransparentBackground_Toggled" />
                        <ToggleSwitch x:Name="LyricsWords" Header="逐字覆盖动画" OnContent="已开启" OffContent="已关闭" Toggled="LyricsWords_Toggled" />
                        <TextBlock Text="按歌词时间轴点亮每个字；仅有逐行时间轴时突出显示当前句。" Style="{StaticResource SecondaryBodyStyle}" />
                        <Slider x:Name="LyricsOffset" Header="歌词校准（0.00 秒）" Minimum="-10" Maximum="10"
                                StepFrequency="0.01" SmallChange="0.01" LargeChange="0.1" IsThumbToolTipEnabled="False"
                                ValueChanged="LyricsOffset_ValueChanged" AutomationProperties.Name="歌词校准（秒）" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="延后 10 秒" Style="{StaticResource SecondaryBodyStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="重置校准" Click="LyricsOffsetReset_Click" Padding="8,4" />
                            <TextBlock Grid.Column="2" Text="提前 10 秒" Style="{StaticResource SecondaryBodyStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="LyricsSourceStatus" Style="{StaticResource SecondaryBodyStyle}" />
                        <Button Content="重新匹配歌词" Click="LyricsReload_Click" HorizontalAlignment="Left" />
                        <Button Content="导入当前歌曲的歌词…" Click="LyricsImport_Click" HorizontalAlignment="Left" />
                        <TextBlock Text="支持 LRC、QRC、YRC 和 TTML。本地歌词会记住对应歌曲。" Style="{StaticResource SecondaryBodyStyle}" />
                    </StackPanel>
                    <StackPanel x:Name="ClockEditor" Visibility="Collapsed" Spacing="16">
                        <TextBlock Text="表盘显示" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="显示秒针" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="Seconds" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="ClockOption_Toggled" AutomationProperties.Name="显示秒针" />
                        </Grid>
                    </StackPanel>
                    <TextBlock x:Name="CalendarHelp" Visibility="Collapsed" Text="在桌面月历中使用左右箭头切换月份，点击“今”返回本月。悬停日期可查看农历、节日和节气。大尺寸在右侧显示最近的节日与节气倒数，以今天为基准，每天自动更新。" Style="{StaticResource SecondaryBodyStyle}" />
                    <StackPanel x:Name="FileShelfEditor" Visibility="Collapsed" Spacing="12">
                        <ToggleSwitch x:Name="FileShelfFloatingToggle" Header="全局悬浮中转站" Width="Auto" HorizontalAlignment="Left" OnContent="已开启" OffContent="已关闭"
                                      Toggled="FileShelfFloating_Toggled" AutomationProperties.Name="全局悬浮中转站" />
                        <TextBlock Text="在其他应用上方显示，与桌面中转站共用文件列表。拖动窗口标题可以调整位置。" Style="{StaticResource SecondaryBodyStyle}" />
                        <ToggleSwitch x:Name="FileShelfAutoHideToggle" Header="贴边自动收起" Width="Auto" HorizontalAlignment="Left" OnContent="已开启" OffContent="已关闭"
                                      Toggled="FileShelfFloating_Toggled" AutomationProperties.Name="贴边自动收起" />
                        <TextBlock Text="将悬浮窗口拖到屏幕边缘，移开鼠标后收起为标签；鼠标靠近或拖入文件时展开。" Style="{StaticResource SecondaryBodyStyle}" />
                        <Button x:Name="FileShelfResetPosition" Content="重置悬浮位置" Click="FileShelfResetPosition_Click" HorizontalAlignment="Left" />
                        <RadioButtons x:Name="FileShelfModePicker" Header="新文件的收集方式" SelectionChanged="FileShelfModePicker_SelectionChanged"
                                      AutomationProperties.Name="文件中转站收集方式">
                            <x:String>引用原文件</x:String>
                            <x:String>复制到中转站</x:String>
                        </RadioButtons>
                        <TextBlock x:Name="FileShelfModeHelp" Style="{StaticResource SecondaryBodyStyle}" />
                        <TextBlock Text="切换方式仅影响后续添加的文件；已有条目保留各自的收集方式。" Style="{StaticResource SecondaryBodyStyle}" />
                        <TextBlock x:Name="FileShelfSummary" Style="{StaticResource SecondaryBodyStyle}" />
                        <Button x:Name="FileShelfAddButton" Content="添加文件…" Click="FileShelfAdd_Click" HorizontalAlignment="Left" />
                        <Button x:Name="FileShelfClearButton" Content="清空中转站…" Click="FileShelfClear_Click" HorizontalAlignment="Left"
                                Foreground="{ThemeResource DangerBrush}" />
                        <TextBlock x:Name="FileShelfStatus" Style="{StaticResource SecondaryBodyStyle}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="将多个文件拖到桌面或悬浮文件中转站即可收集。单击选中，Ctrl / Shift 多选，拖出后可放入其他应用；双击打开，右键可打开所在位置、复制路径或移除。" Style="{StaticResource SecondaryBodyStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="NoteHelp" Visibility="Collapsed" Text="点击桌面便签正文即可编辑，内容自动保存。Enter 换行，Esc 或点击其他区域结束编辑；滚动可阅读长便签。" Style="{StaticResource SecondaryBodyStyle}" />
                    <StackPanel x:Name="TodoEditor" Visibility="Collapsed" Spacing="10">
                        <TextBlock Text="待办清单" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="NewTaskInput" PlaceholderText="添加一项待办，按 Enter 确认" MaxLength="500" KeyDown="NewTaskInput_KeyDown" AutomationProperties.Name="新待办内容" />
                            <Button Grid.Column="1" Content="添加" Click="AddTask_Click" />
                        </Grid>
                        <StackPanel x:Name="TaskRows" Spacing="8" />
                        <TextBlock Text="桌面卡片可直接添加、编辑和勾选待办，滚动可查看其余事项。" Style="{StaticResource SecondaryBodyStyle}" />
                    </StackPanel>
                    <StackPanel x:Name="TranslationEditor" Visibility="Collapsed" Spacing="16">
                        <TextBlock Text="AI 接口" FontWeight="SemiBold" />
                        <TextBox x:Name="TranslationBaseUrl" Header="接口地址" PlaceholderText="https://api.example.com/v1" TextChanged="TranslationSettings_TextChanged" />
                        <PasswordBox x:Name="TranslationApiKey" Header="API Key" PlaceholderText="本地模型可留空" PasswordChanged="TranslationApiKey_PasswordChanged" />
                        <TextBox x:Name="TranslationModel" Header="模型" PlaceholderText="输入模型名称" TextChanged="TranslationSettings_TextChanged" />
                        <StackPanel Spacing="12">
                            <TextBlock Text="翻译会话" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="复用会话" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="TranslationReuseConversation" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                              Toggled="TranslationReuseConversation_Toggled" AutomationProperties.Name="复用翻译会话" />
                            </Grid>
                            <TextBlock Text="连续翻译时保留上下文，保持术语和表达一致。" Style="{StaticResource SecondaryBodyStyle}" />
                            <NumberBox x:Name="TranslationConversationIdle" Header="闲置后新建会话（分钟）" Minimum="1" Maximum="1440"
                                       SmallChange="1" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten"
                                       ValueChanged="TranslationConversationIdle_ValueChanged" AutomationProperties.Name="翻译会话闲置分钟数" />
                            <TextBlock Text="达到闲置时间后，下次翻译将新建会话。会话仅在本次运行中保留；更换翻译配置、目标语言或会话过长时也会自动新建。"
                                       Style="{StaticResource SecondaryBodyStyle}" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBox x:Name="TranslationPrompt" Header="翻译提示词" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="144" MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     PlaceholderText="留空使用默认翻译提示词" TextChanged="TranslationSettings_TextChanged" />
                            <TextBlock Text="使用 {targetLanguage} 代表组件中选择的目标语言。修改后自动保存；留空使用默认提示词。"
                                       Style="{StaticResource SecondaryBodyStyle}" />
                            <Button Content="恢复默认提示词" HorizontalAlignment="Left" Click="ResetTranslationPrompt_Click" />
                        </StackPanel>
                        <TextBlock Text="支持 OpenAI 兼容接口。点击桌面卡片输入原文，选择目标语言后点击“翻译”或按 Ctrl+Enter。" Style="{StaticResource SecondaryBodyStyle}" />
                    </StackPanel>
                    <StackPanel x:Name="PerformanceEditor" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="系统性能" FontWeight="SemiBold" />
                        <TextBlock Text="每秒更新整台电脑的 CPU、GPU、内存和磁盘状态。首轮采样、设备不支持或暂时无法读取的指标显示 —。GPU 显示最繁忙图形引擎的占用率，磁盘显示系统物理磁盘的活动比例。" Style="{StaticResource SecondaryBodyStyle}" />
                        <TextBlock x:Name="PerformanceSummary" Style="{StaticResource SecondaryBodyStyle}" />
                    </StackPanel>
                    <StackPanel x:Name="NetworkEditor" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="网络设置" FontWeight="SemiBold" />
                        <ComboBox x:Name="NetworkDisplayModePicker" Header="显示样式" HorizontalAlignment="Stretch" SelectionChanged="NetworkDisplayModePicker_SelectionChanged" />
                        <StackPanel x:Name="NetworkProcessOptions" Spacing="8">
                            <RadioButtons x:Name="NetworkProcessSortPicker" Header="进程排行" MaxColumns="2"
                                          SelectionChanged="NetworkProcessSortPicker_SelectionChanged">
                                <RadioButton Content="按下载排序" />
                                <RadioButton Content="按上传排序" />
                            </RadioButtons>
                            <TextBlock Text="显示当前流量最高的三个进程，统计全部网卡的 TCP/UDP 流量。也可在桌面卡片上切换排序。进程统计需要以管理员身份运行 CrabDesk。"
                                       Style="{StaticResource SecondaryBodyStyle}" />
                            <TextBlock x:Name="NetworkProcessSummary" Style="{StaticResource SecondaryBodyStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="NetworkAdapterPicker" Header="网络适配器" HorizontalAlignment="Stretch" SelectionChanged="NetworkAdapterPicker_SelectionChanged" />
                        <TextBox x:Name="NetworkLatencyInput" Header="延迟测量目标" PlaceholderText="IP 或主机名；留空使用默认网关" MaxLength="253" LostFocus="NetworkLatencyInput_LostFocus" KeyDown="NetworkLatencyInput_KeyDown" />
                        <TextBlock Text="按 Enter 或离开输入框时保存。网速为所选适配器的实时流量。延迟通过 ICMP 按系统路由测量，不绑定所选适配器；目标不响应时显示超时。" Style="{StaticResource SecondaryBodyStyle}" />
                        <TextBlock x:Name="NetworkSummary" Style="{StaticResource SecondaryBodyStyle}" />
                    </StackPanel>
                    <StackPanel x:Name="WeatherEditor" Visibility="Collapsed" Spacing="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="城市管理" FontWeight="SemiBold" />
                            <StackPanel Spacing="8">
                                <TextBlock Text="桌面显示城市" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" />
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="SavedCities" PlaceholderText="添加一个城市" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" SelectionChanged="SavedCities_SelectionChanged" AutomationProperties.Name="桌面显示城市" />
                                    <Button x:Name="RemoveCityButton" Grid.Column="1" Padding="8,0" Click="RemoveCity_Click" AutomationProperties.Name="移除当前城市" ToolTipService.ToolTip="移除当前城市">
                                        <icons:TablerIcon Icon="Trash" FontSize="14" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                            <AutoSuggestBox x:Name="CityQuery" Header="添加城市" PlaceholderText="输入城市名，按 Enter 搜索" QueryIcon="Find"
                                            TextMemberPath="Name" QuerySubmitted="CityQuery_QuerySubmitted" TextChanged="CityQuery_TextChanged" />
                            <TextBlock x:Name="CitySearchStatus" Style="{StaticResource SecondaryBodyStyle}"
                                       Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                            <Button x:Name="LocateCityButton" Content="使用当前位置" Click="LocateCity_Click" HorizontalAlignment="Left" ToolTipService.ToolTip="仅在点击时获取 Windows 系统位置" />
                            <HyperlinkButton x:Name="LocationSettings" Content="打开系统定位设置" NavigateUri="ms-settings:privacy-location" Padding="0" HorizontalAlignment="Left" Visibility="Collapsed" />
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource SubtleBorderBrush}" />
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="天气状态" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button x:Name="RefreshWeatherButton" Grid.Column="1" Padding="8,0" Click="RefreshWeather_Click" ToolTipService.ToolTip="刷新天气" AutomationProperties.Name="刷新天气">
                                    <icons:TablerIcon Icon="Refresh" FontSize="14" />
                                </Button>
                            </Grid>
                            <TextBlock x:Name="CurrentCity" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="WeatherDetails" Style="{StaticResource SecondaryBodyStyle}" />
                            <HyperlinkButton x:Name="WeatherSource" Content="数据来自小米天气" FontSize="12" NavigateUri="https://privacy.mi.com/weather/zh_CN/" Padding="0" HorizontalAlignment="Left" ToolTipService.ToolTip="每 30 分钟更新；刷新失败时保留已有天气数据" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="OperationStatus" Style="{StaticResource SecondaryBodyStyle}"
                               Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                    <Border x:Name="WidgetAppearanceSettings" Style="{StaticResource SectionCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="外观风格" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock x:Name="WidgetCenterMaterialHint" Text="中心使用实色背景，配色跟随组件中心主题。"
                                       Visibility="Collapsed" Style="{StaticResource SecondaryBodyStyle}" TextWrapping="Wrap" />
                            <ComboBox x:Name="WidgetMaterialPicker" Header="背景材质" HorizontalAlignment="Stretch" SelectionChanged="WidgetMaterialPicker_SelectionChanged" AutomationProperties.Name="组件背景材质">
                                <ComboBoxItem Content="实色" />
                                <ComboBoxItem Content="亚克力" />
                            </ComboBox>
                            <ComboBox x:Name="WidgetThemePicker" Header="配色主题" HorizontalAlignment="Stretch" SelectionChanged="WidgetThemePicker_SelectionChanged" AutomationProperties.Name="组件配色主题">
                                <ComboBoxItem Content="组件特色" />
                                <ComboBoxItem Content="浅色" />
                                <ComboBoxItem Content="深色" />
                            </ComboBox>
                            <TextBlock x:Name="WidgetMaterialHint" Style="{StaticResource SecondaryBodyStyle}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="TypographySettings" Style="{StaticResource SectionCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="字体设置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox x:Name="WidgetFontFamily" Header="字体" HorizontalAlignment="Stretch" SelectionChanged="WidgetTypography_SelectionChanged" AutomationProperties.Name="组件字体" />
                            <NumberBox x:Name="WidgetFontScale" Header="文字大小（%）" Minimum="75" Maximum="150" SmallChange="5" LargeChange="10" SpinButtonPlacementMode="Compact" ValueChanged="WidgetFontScale_ValueChanged" AutomationProperties.Name="组件文字大小" />
                            <ComboBox x:Name="WidgetFontWeight" Header="字重" HorizontalAlignment="Stretch" SelectionChanged="WidgetTypography_SelectionChanged" AutomationProperties.Name="组件字重" />
                            <ToggleSwitch x:Name="WidgetFontItalic" Header="斜体" Toggled="WidgetFontItalic_Toggled" AutomationProperties.Name="组件斜体" />
                            <Button Content="恢复默认字体" HorizontalAlignment="Left" Click="ResetWidgetTypography_Click" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="CardSettings" Style="{StaticResource SectionCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="卡片设置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox x:Name="TitleInput" Header="卡片名称" PlaceholderText="使用组件默认名称" MaxLength="80" TextChanged="TitleInput_TextChanged" />
                            <ComboBox x:Name="SizePicker" Header="尺寸" SelectionChanged="SizePicker_SelectionChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="组件尺寸" />
                            <StackPanel x:Name="CustomSizeSettings" Spacing="8" Visibility="Collapsed">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <NumberBox x:Name="WidgetWidth" Header="宽（DIP）" Minimum="180" SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Compact" AutomationProperties.Name="组件宽度" />
                                    <NumberBox x:Name="WidgetHeight" Grid.Column="1" Header="高（DIP）" Minimum="120" SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Compact" AutomationProperties.Name="组件高度" />
                                </Grid>
                                <Button Content="应用尺寸" Click="ApplyCustomSize_Click" HorizontalAlignment="Left" />
                                <TextBlock Text="也可拖动桌面卡片的边缘或角落调整。锁定位置后禁止拖拽调整尺寸。" Style="{StaticResource SecondaryBodyStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="MonitorPicker" Header="显示器" DisplayMemberPath="Label" SelectionChanged="MonitorPicker_SelectionChanged" HorizontalAlignment="Stretch" />
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="锁定位置" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="PositionLock" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="PositionLock_Toggled" AutomationProperties.Name="锁定组件位置" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Button x:Name="RemoveWidgetButton" Content="移除组件" Click="RemoveWidget_Click" HorizontalAlignment="Left" Foreground="{ThemeResource DangerBrush}" />
                </StackPanel>
                </ScrollViewer>
            </Grid>
            <ScrollViewer x:Name="AppearanceView" Visibility="Collapsed" IsTabStop="False" HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Padding="0,0,12,16">
                <StackPanel Spacing="20">
                    <Border Style="{StaticResource SectionCardStyle}" Padding="24">
                        <StackPanel Spacing="16">
                            <TextBlock Text="组件中心" FontSize="18" FontWeight="SemiBold" />
                            <ComboBox x:Name="WidgetCenterThemePicker" Header="组件中心主题"
                                      HorizontalAlignment="Stretch" SelectionChanged="WidgetCenterThemePicker_SelectionChanged"
                                      AutomationProperties.Name="组件中心主题">
                                <ComboBoxItem Content="跟随系统" Tag="System" />
                                <ComboBoxItem Content="浅色" Tag="Light" />
                                <ComboBoxItem Content="深色" Tag="Dark" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SectionCardStyle}" Padding="24">
                        <StackPanel Spacing="16">
                            <TextBlock Text="组件圆角" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="统一应用于实色和亚克力组件。0 为直角，更改自动保存。"
                                       Style="{StaticResource SecondaryBodyStyle}" />
                            <Slider x:Name="WidgetCornerRadius" Header="圆角半径" Minimum="0" Maximum="20"
                                    StepFrequency="1" SmallChange="1" LargeChange="4" IsThumbToolTipEnabled="False"
                                    ValueChanged="WidgetCornerRadius_ValueChanged" AutomationProperties.Name="组件圆角半径（DIP）" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="WidgetAcrylicSettings" Padding="24" CornerRadius="12" Background="{ThemeResource SectionSurfaceBrush}"
                            BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="20">
                            <StackPanel Spacing="6">
                                <TextBlock Text="组件亚克力" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="统一应用于所有亚克力组件，包括歌词的亚克力背景。更改自动保存。"
                                           Style="{StaticResource SecondaryBodyStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="WidgetAcrylicFollowBox" Header="跟随盒子"
                                          OnContent="使用盒子外观" OffContent="使用组件统一设置"
                                          Toggled="WidgetAcrylicFollowBox_Toggled"
                                          AutomationProperties.Name="组件亚克力跟随盒子" />
                            <TextBlock x:Name="WidgetAcrylicSourceHint" Style="{StaticResource SecondaryBodyStyle}" TextWrapping="Wrap" />
                            <StackPanel x:Name="WidgetAcrylicCustomSettings" Spacing="20">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="背景颜色" FontWeight="SemiBold" />
                                    <Button HorizontalAlignment="Left" AutomationProperties.Name="选择组件亚克力背景色">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border x:Name="WidgetAcrylicSwatch" Width="22" Height="22" CornerRadius="4"
                                                    BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" />
                                            <TextBlock x:Name="WidgetAcrylicColorLabel" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <ColorPicker x:Name="WidgetAcrylicColor" Width="{StaticResource ColorPickerWidth}"
                                                             IsAlphaEnabled="False" IsColorPreviewVisible="True"
                                                             IsColorSliderVisible="True" IsColorChannelTextInputVisible="True"
                                                             IsHexInputVisible="True" ColorChanged="WidgetAcrylicColor_ColorChanged"
                                                             AutomationProperties.Name="组件亚克力背景色选择器" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <Slider x:Name="WidgetAcrylicOpacity" Header="背景不透明度" Minimum="0" Maximum="100"
                                        StepFrequency="1" SmallChange="1" LargeChange="10" IsThumbToolTipEnabled="False"
                                        ValueChanged="WidgetAcrylicOpacity_ValueChanged" AutomationProperties.Name="组件亚克力背景不透明度（%）" />
                                <Slider x:Name="WidgetAcrylicBlur" Header="模糊强度" Minimum="0" Maximum="100"
                                        StepFrequency="1" SmallChange="1" LargeChange="10" IsThumbToolTipEnabled="False"
                                        ValueChanged="WidgetAcrylicBlur_ValueChanged" AutomationProperties.Name="组件亚克力模糊强度（%）" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="亚克力组件保留各自的表盘、内容面板与功能配色。实色组件使用各自的黑白主题。"
                               Style="{StaticResource SecondaryBodyStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
    <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Error" VerticalAlignment="Bottom" Margin="24,0,24,16"
             Visibility="{Binding IsOpen, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</Page>
