<Page
    x:Class="CrabDesk.WinUI.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:CrabDesk.Core"
    xmlns:lucide="using:CrabDesk.WinUI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
        <StackPanel Padding="{StaticResource PagePadding}"
                    HorizontalAlignment="Stretch" Spacing="24">
            <StackPanel>
                <TextBlock Text="桌面卡顿诊断" Style="{StaticResource SectionTitleStyle}" />
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryBodyStyle}"
                                   Text="测量资源管理器桌面线程的响应速度，判断「文件落到桌面后卡住数秒」是第三方 Shell 扩展造成的，还是 CrabDesk 自身被阻塞。诊断会临时创建一个文件触发桌面刷新并立即删除，不会修改系统设置。" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding RunDiagnosticsCommand}" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <lucide:LucideIcon Icon="Stethoscope" />
                                    <TextBlock Text="开始诊断" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CopyReportCommand}" IsEnabled="{Binding HasReport}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <lucide:LucideIcon Icon="ClipboardCopy" />
                                    <TextBlock Text="复制报告" />
                                </StackPanel>
                            </Button>
                            <ProgressRing IsActive="{Binding IsRunning}" Width="20" Height="20"
                                          VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource SecondaryBodyStyle}"
                                   Visibility="{Binding StatusText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="测量结果" Style="{StaticResource SectionTitleStyle}" />
                <Border Style="{StaticResource SectionCardStyle}" Padding="16,0">
                    <StackPanel>
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="空闲基线" FontWeight="SemiBold" />
                                    <TextBlock Text="没有新文件时，桌面线程的正常响应耗时"
                                               Style="{StaticResource SecondaryBodyStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding IdleBaselineText}"
                                           VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="普通目录写入（对照）" FontWeight="SemiBold" />
                                    <TextBlock Text="往「文档」写一个文件，作为对照组"
                                               Style="{StaticResource SecondaryBodyStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding OrdinaryFolderText}"
                                           VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="桌面目录写入" FontWeight="SemiBold" />
                                    <TextBlock Text="往桌面写一个文件，即触发卡顿的操作"
                                               Style="{StaticResource SecondaryBodyStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding DesktopFolderText}"
                                           VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRowStyle}" BorderThickness="0">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="同时刻 CrabDesk 响应" FontWeight="SemiBold" />
                                    <TextBlock Text="与上一项交替采样，两者取自同一时刻；若此处也很大，说明是 CrabDesk 的问题"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource SecondaryBodyStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding CrabDeskSurfaceText}"
                                           VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="结论" Style="{StaticResource SectionTitleStyle}" />
                <InfoBar IsOpen="True"
                         IsClosable="False"
                         Severity="{Binding VerdictSeverity}"
                         Title="{Binding VerdictText}"
                         Message="{Binding VerdictDetail}" />
            </StackPanel>

            <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="可疑的第三方 Shell 扩展" Style="{StaticResource SectionTitleStyle}" />
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding ExtensionSummaryText}"
                                   TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryBodyStyle}"
                                   Text="这些组件在资源管理器进程内运行。禁用它们属于系统级改动（需要管理员权限），请自行判断是否用 ShellExView 之类工具处理，或退出、卸载对应软件后重新诊断。" />
                        <ListView ItemsSource="{Binding Extensions}"
                                  SelectionMode="None"
                                  MaxHeight="320"
                                  Visibility="{Binding HasExtensions, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:ShellExtensionEntry">
                                    <StackPanel Padding="0,6" Spacing="2"
                                                AutomationProperties.Name="{x:Bind Product}">
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{x:Bind Product}" />
                                            <Run Text=" · " />
                                            <Run Text="{x:Bind Name}" />
                                        </TextBlock>
                                        <TextBlock Text="{x:Bind Path}"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource SecondaryBodyStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
