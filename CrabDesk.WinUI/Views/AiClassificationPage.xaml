<Page
    x:Class="CrabDesk.WinUI.Views.AiClassificationPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lucide="using:CrabDesk.WinUI.Controls">
    <Grid Padding="{StaticResource PagePadding}">
        <Grid ColumnSpacing="12" MinWidth="860">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SectionCardStyle}" Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="桌面图标" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedItemSummary}"
                                       Style="{StaticResource SecondaryBodyStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding RefreshWorkspaceCommand}"
                                ToolTipService.ToolTip="刷新桌面图标"
                                AutomationProperties.Name="刷新桌面图标">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <lucide:LucideIcon Icon="RefreshCw" FontSize="15" />
                                <TextBlock Text="刷新" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Command="{Binding SelectAllCommand}"
                                ToolTipService.ToolTip="选择全部桌面图标">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <lucide:LucideIcon Icon="CheckCheck" FontSize="15" />
                                <TextBlock Text="全选" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3"
                                Command="{Binding ClearSelectionCommand}"
                                ToolTipService.ToolTip="清除全部选择">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <lucide:LucideIcon Icon="SquareDashed" FontSize="15" />
                                <TextBlock Text="清除" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      HorizontalContentAlignment="Stretch">
                            <ItemsRepeater ItemsSource="{Binding WorkspaceItems}"
                                           HorizontalAlignment="Stretch"
                                           Margin="0,0,4,0">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="132"
                                                       MinItemHeight="136"
                                                       MinColumnSpacing="10"
                                                       MinRowSpacing="10"
                                                       ItemsStretch="None"
                                                       ItemsJustification="Start"
                                                       Orientation="Horizontal" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="132"
                                                MinHeight="136"
                                                Padding="10"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch">
                                            <Grid RowSpacing="6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="58" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Width="32"
                                                          Height="32"
                                                          MinWidth="32"
                                                          MinHeight="32"
                                                          Padding="0"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Top"
                                                          Canvas.ZIndex="1"
                                                          AutomationProperties.Name="选择桌面图标" />
                                                <Button Width="64"
                                                        Height="58"
                                                        MinWidth="64"
                                                        MinHeight="58"
                                                        Padding="2"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="0"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.ToggleWorkspaceItemSelectionCommand, ElementName=RootPage}"
                                                        CommandParameter="{Binding}"
                                                        ToolTipService.ToolTip="切换选择"
                                                        AutomationProperties.Name="切换桌面图标选择">
                                                    <Grid Width="54" Height="54">
                                                        <lucide:LucideIcon Icon="File"
                                                                           FontSize="32"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Visibility="{Binding HasIcon, Converter={StaticResource BooleanNegationToVisibilityConverter}}" />
                                                        <Image Source="{Binding Icon}"
                                                               Width="48"
                                                               Height="48"
                                                               Stretch="Uniform"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </Grid>
                                                </Button>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding DisplayName}"
                                                           TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="Wrap"
                                                           MaxLines="2"
                                                           MinHeight="36"
                                                           FontSize="14"
                                                           VerticalAlignment="Top" />
                                                <StackPanel Grid.Row="2" Spacing="4">
                                                    <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                            CornerRadius="10"
                                                            Padding="7,3"
                                                            Visibility="{Binding HasAiLabel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding AiLabel}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   HorizontalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Spacing="4"
                                                                Visibility="{Binding IsUncertain, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                                CornerRadius="10"
                                                                Padding="7,3">
                                                            <TextBlock Text="待确认"
                                                                       HorizontalAlignment="Center"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                        <ComboBox ItemsSource="{Binding DataContext.CategoryTags, ElementName=RootPage}"
                                                                  SelectedItem="{Binding ManualLabel, Mode=TwoWay}"
                                                                  IsEnabled="{Binding IsSelected}"
                                                                  PlaceholderText="选择标签"
                                                                  FontSize="12" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsWorkspaceEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <lucide:LucideIcon Icon="Inbox" FontSize="32" HorizontalAlignment="Center" />
                            <TextBlock Text="当前没有位于桌面的可整理图标" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource SectionCardStyle}"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Margin="14,12,14,10" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="15" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <lucide:LucideIcon Icon="Sparkles" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="1">
                                <TextBlock Text="CrabDesk AI" FontWeight="SemiBold" />
                                <TextBlock Text="桌面分类助手" Style="{StaticResource SecondaryBodyStyle}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="SettingsButton"
                                Grid.Column="1"
                                Click="SettingsButton_OnClick"
                                Padding="8"
                                MinHeight="32"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="AI 设置"
                                AutomationProperties.Name="打开 AI 设置">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <lucide:LucideIcon Icon="Settings" FontSize="16" />
                                <TextBlock Text="设置" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Conversation Flow -->
                    <ListView x:Name="ConversationList"
                              Grid.Row="1"
                              ItemsSource="{Binding Conversation}"
                              SelectionMode="None"
                              Padding="8,2,8,4">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <!-- System message -->
                                    <StackPanel Spacing="2"
                                                HorizontalAlignment="Center"
                                                Visibility="{Binding IsSystem, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Text}"
                                                   Style="{StaticResource SecondaryBodyStyle}"
                                                   FontSize="12"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding TimeText}"
                                                   Style="{StaticResource SecondaryBodyStyle}"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- User message -->
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Visibility="{Binding IsUser, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border MaxWidth="330"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="10"
                                                Padding="10,6">
                                            <TextBlock Text="{Binding Text}"
                                                       Foreground="White"
                                                       FontSize="13"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Assistant message -->
                                    <Border MaxWidth="380"
                                            HorizontalAlignment="Left"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10"
                                            Visibility="{Binding IsAssistant, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Border Width="22" Height="22" CornerRadius="11" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                                        <lucide:LucideIcon Icon="Sparkles" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="CrabDesk AI" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding TimeText}"
                                                           Style="{StaticResource SecondaryBodyStyle}"
                                                           FontSize="10"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <lucide:LucideIcon Icon="CircleAlert" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                       Visibility="{Binding IsError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <ProgressRing Width="12" Height="12" IsActive="{Binding IsRunning}"
                                                                  Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" />

                                            <TextBlock Text="{Binding TransportText}"
                                                       Style="{StaticResource SecondaryBodyStyle}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding TransportText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />

                                            <!-- Tool calls -->
                                            <ItemsControl ItemsSource="{Binding ToolCalls}"
                                                          Visibility="{Binding HasToolCalls, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="8" Margin="0,0,0,4" Padding="7"
                                                              Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                              BorderThickness="1"
                                                              CornerRadius="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <lucide:LucideIcon Icon="{Binding Icon}" FontSize="13" VerticalAlignment="Center"
                                                                               Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Detail}" FontSize="10" TextTrimming="CharacterEllipsis" Style="{StaticResource SecondaryBodyStyle}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                <ProgressRing Width="11" Height="11" IsActive="{Binding IsRunning}"
                                                                              Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <TextBlock Text="{Binding TimeText}" FontSize="10" Style="{StaticResource SecondaryBodyStyle}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Thinking -->
                                            <Expander IsExpanded="{Binding IsThinkingExpanded, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Stretch"
                                                      Visibility="{Binding ThinkingText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                                <Expander.Header>
                                                    <Grid ColumnSpacing="8" HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <lucide:LucideIcon Icon="Brain" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="思考过程" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding ThinkingStatsText}" Style="{StaticResource SecondaryBodyStyle}" FontSize="10"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding ThinkingStatsText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Command="{Binding DataContext.CopyMessageThinkingCommand, ElementName=RootPage}"
                                                                CommandParameter="{Binding}"
                                                                Padding="5,2" MinHeight="24" Height="24"
                                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                                                ToolTipService.ToolTip="复制思考过程" AutomationProperties.Name="复制思考过程">
                                                            <lucide:LucideIcon Icon="Copy" FontSize="11" />
                                                        </Button>
                                                    </Grid>
                                                </Expander.Header>
                                                <Border Margin="0,6,0,0" Padding="7"
                                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="8">
                                                    <TextBox Text="{Binding ThinkingText}"
                                                             IsReadOnly="True"
                                                             AcceptsReturn="True"
                                                             TextWrapping="NoWrap"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                             FontFamily="Consolas"
                                                             FontSize="11"
                                                             MinHeight="60"
                                                             MaxHeight="200"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             TextChanged="MessageTextBox_OnTextChanged" />
                                                </Border>
                                            </Expander>

                                            <TextBlock Text="{Binding ParsedText}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                       Margin="0,-2,0,0"
                                                       Visibility="{Binding ParsedText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />

                                            <TextBlock Text="{Binding MetricsText}"
                                                       Style="{StaticResource SecondaryBodyStyle}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       Margin="0,-2,0,0"
                                                       Visibility="{Binding MetricsText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />

                                            <!-- Result JSON -->
                                            <Expander HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Stretch"
                                                      Visibility="{Binding ResultJsonText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                                <Expander.Header>
                                                    <Grid ColumnSpacing="8" HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <lucide:LucideIcon Icon="Braces" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="分类结果 JSON" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Command="{Binding DataContext.CopyMessageResultJsonCommand, ElementName=RootPage}"
                                                                CommandParameter="{Binding}"
                                                                Padding="5,2" MinHeight="24" Height="24"
                                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                                                ToolTipService.ToolTip="复制 JSON" AutomationProperties.Name="复制分类结果 JSON">
                                                            <lucide:LucideIcon Icon="Copy" FontSize="11" />
                                                        </Button>
                                                    </Grid>
                                                </Expander.Header>
                                                <Border Margin="0,6,0,0" Padding="7"
                                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="8">
                                                    <TextBox Text="{Binding ResultJsonText}"
                                                             IsReadOnly="True"
                                                             AcceptsReturn="True"
                                                             TextWrapping="NoWrap"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                             FontFamily="Consolas"
                                                             FontSize="11"
                                                             MinHeight="60"
                                                             MaxHeight="240"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             TextChanged="MessageTextBox_OnTextChanged" />
                                                </Border>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Pinned preview result -->
                    <Border Grid.Row="2"
                            Margin="12,4,12,6"
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="{Binding HasPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <lucide:LucideIcon Icon="Sparkles" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="分类结果" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ResultSummaryText}" Style="{StaticResource SecondaryBodyStyle}" FontSize="11" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Command="{Binding ShowCardViewCommand}" Padding="6,2" MinHeight="26" Height="26"
                                            Background="{Binding IsJsonViewMode, Converter={StaticResource BoolToViewToggleBrushConverter}, ConverterParameter=invert}"
                                            Foreground="{Binding IsJsonViewMode, Converter={StaticResource ViewToggleForegroundConverter}, ConverterParameter=invert}"
                                            ToolTipService.ToolTip="看板卡片视图" AutomationProperties.Name="看板卡片视图">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <lucide:LucideIcon Icon="LayoutGrid" FontSize="12" />
                                            <TextBlock Text="看板" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ShowJsonViewCommand}" Padding="6,2" MinHeight="26" Height="26"
                                            Background="{Binding IsJsonViewMode, Converter={StaticResource BoolToViewToggleBrushConverter}}"
                                            Foreground="{Binding IsJsonViewMode, Converter={StaticResource ViewToggleForegroundConverter}}"
                                            ToolTipService.ToolTip="原始 JSON 视图" AutomationProperties.Name="JSON 视图">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <lucide:LucideIcon Icon="Code" FontSize="12" />
                                            <TextBlock Text="JSON" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding CopyStructuredOutputCommand}" Padding="6,2" MinHeight="26" Height="26"
                                            ToolTipService.ToolTip="复制 JSON 内容" AutomationProperties.Name="复制 JSON 内容">
                                        <lucide:LucideIcon Icon="Copy" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <StackPanel Visibility="{Binding IsJsonViewMode, Converter={StaticResource BooleanNegationToVisibilityConverter}}" Spacing="6">
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsRepeater ItemsSource="{Binding ResultGroups}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="6" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="9">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="{Binding CategoryName}" FontSize="12" FontWeight="SemiBold" />
                                                    <ItemsRepeater ItemsSource="{Binding Items}">
                                                        <ItemsRepeater.Layout>
                                                            <StackLayout Orientation="Horizontal" Spacing="6" />
                                                        </ItemsRepeater.Layout>
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="6"
                                                                        Padding="6,4">
                                                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                </ScrollViewer>
                                <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{Binding HasResultGroups, Converter={StaticResource BooleanNegationToVisibilityConverter}}">
                                    <TextBlock Text="{Binding StructuredOutput}" Style="{StaticResource SecondaryBodyStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsJsonViewMode, Converter={StaticResource BooleanToVisibilityConverter}}" Spacing="6">
                                <TextBox Text="{Binding StructuredOutput}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         MinHeight="80"
                                         MaxHeight="220"
                                         Background="Transparent"
                                         BorderThickness="0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Composer -->
                    <Border Grid.Row="3"
                            Padding="12,10,12,12"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <ProgressBar IsIndeterminate="{Binding IsProgressIndeterminate}"
                                         Maximum="100"
                                         Value="{Binding ProgressValue}"
                                         Visibility="{Binding HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="{Binding Status}"
                                       Style="{StaticResource SecondaryBodyStyle}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Command="{Binding ClassifyCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <lucide:LucideIcon Icon="Sparkles" FontSize="15" />
                                        <TextBlock Text="开始 AI 分类" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1"
                                        Command="{Binding ApplyCommand}"
                                        IsEnabled="{Binding CanApplyPreview}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <lucide:LucideIcon Icon="Check" FontSize="14" />
                                        <TextBlock Text="确认应用" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2"
                                        Command="{Binding CancelCommand}"
                                        ToolTipService.ToolTip="终止本次 AI 分类"
                                        AutomationProperties.Name="终止 AI 分类">
                                    <lucide:LucideIcon Icon="Square" FontSize="14" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>
