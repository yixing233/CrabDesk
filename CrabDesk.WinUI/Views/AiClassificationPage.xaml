<Page
    x:Class="CrabDesk.WinUI.Views.AiClassificationPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lucide="using:CrabDesk.WinUI.Controls">
    <Page.Resources>
        <!-- One agent timeline row: status icon + display text (+ spinner while running) -->
        <DataTemplate x:Key="AiActivityRowTemplate">
            <Grid ColumnSpacing="7" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <lucide:LucideIcon Icon="Sparkles" FontSize="12"
                                   Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <lucide:LucideIcon Icon="Check" FontSize="12"
                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsClassified, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <lucide:LucideIcon Icon="CircleAlert" FontSize="12"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsUncertain, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <lucide:LucideIcon Icon="Square" FontSize="10"
                                   Foreground="{ThemeResource SecondaryTextBrush}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsStopped, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding DisplayText}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <ProgressRing Grid.Column="2" Width="10" Height="10" IsActive="{Binding IsRunning}"
                              Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid Padding="{StaticResource PagePadding}">
        <Grid ColumnSpacing="12" MinWidth="900">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="460" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SectionCardStyle}" Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="桌面图标" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedItemSummary}"
                                       Style="{StaticResource SecondaryBodyStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding RefreshWorkspaceCommand}"
                                ToolTipService.ToolTip="刷新桌面图标"
                                AutomationProperties.Name="刷新桌面图标">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <lucide:LucideIcon Icon="RefreshCw" FontSize="15" />
                                <TextBlock Text="刷新" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Command="{Binding SelectAllCommand}"
                                ToolTipService.ToolTip="选择全部桌面图标">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <lucide:LucideIcon Icon="CheckCheck" FontSize="15" />
                                <TextBlock Text="全选" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3"
                                Command="{Binding ClearSelectionCommand}"
                                ToolTipService.ToolTip="清除全部选择">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <lucide:LucideIcon Icon="SquareDashed" FontSize="15" />
                                <TextBlock Text="清除" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Search: filters the grid live by icon name or classification text -->
                    <AutoSuggestBox Grid.Row="1"
                                    Text="{Binding WorkspaceFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextChanged="WorkspaceSearchBox_OnTextChanged"
                                    PlaceholderText="搜索图标名称或分类"
                                    QueryIcon="Find"
                                    AutomationProperties.Name="搜索桌面图标" />

                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      HorizontalContentAlignment="Stretch">
                            <ItemsRepeater ItemsSource="{Binding VisibleWorkspaceItems}"
                                           HorizontalAlignment="Stretch"
                                           Margin="0,0,4,0">
                                <ItemsRepeater.Layout>
                                    <!-- Slot size == card size (132×140). Every card reserves the same
                                         three rows, so a label appearing after classification can never
                                         outgrow its slot and get clipped by the card's rounded corners.
                                         ItemsStretch=Fill widens the column slots so whole columns always
                                         span the available width (the card itself keeps its fixed width and
                                         sits centered in its slot); the leftover that used to pile up as a
                                         blank strip on the right is spread evenly between the columns, and
                                         a partial last row still lines up with the columns above it. -->
                                    <UniformGridLayout MinItemWidth="132"
                                                       MinItemHeight="140"
                                                       MinColumnSpacing="10"
                                                       MinRowSpacing="10"
                                                       ItemsStretch="Fill"
                                                       ItemsJustification="Start"
                                                       Orientation="Horizontal" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Fixed 132×140 card: 8px padding + icon 56 + 4 + name 36 (two 18px lines) + 4 + label 24 + 8px.
                                             The checkbox floats in the top-right corner beside the icon instead of on top of it;
                                             the classification chip always lands in the reserved bottom row. -->
                                        <Border Width="132"
                                                Height="140"
                                                Padding="8"
                                                CornerRadius="8"
                                                Background="Transparent"
                                                HorizontalAlignment="Center">
                                            <Grid>
                                                <!-- Content dims when the card is deselected; the checkbox stays crisp. -->
                                                <Grid RowSpacing="4"
                                                      Opacity="{Binding IsSelected, Converter={StaticResource BooleanToOpacityConverter}}">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="56" />
                                                        <RowDefinition Height="36" />
                                                        <RowDefinition Height="24" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Icon (click toggles selection) -->
                                                    <Button Width="56"
                                                            Height="56"
                                                            MinWidth="56"
                                                            MinHeight="56"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderBrush="Transparent"
                                                            BorderThickness="0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.ToggleWorkspaceItemSelectionCommand, ElementName=RootPage}"
                                                            CommandParameter="{Binding}"
                                                            ToolTipService.ToolTip="切换选择"
                                                            AutomationProperties.Name="切换桌面图标选择">
                                                        <Grid Width="48" Height="48">
                                                            <lucide:LucideIcon Icon="File"
                                                                               FontSize="32"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Visibility="{Binding HasIcon, Converter={StaticResource BooleanNegationToVisibilityConverter}}" />
                                                            <Image Source="{Binding Icon}"
                                                                   Width="48"
                                                                   Height="48"
                                                                   Stretch="Uniform"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        </Grid>
                                                    </Button>

                                                    <!-- Name: at most two lines of fixed height; the full name lives in the tooltip -->
                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding DisplayName}"
                                                               TextAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="Wrap"
                                                               MaxLines="2"
                                                               FontSize="13"
                                                               LineHeight="18"
                                                               LineStackingStrategy="BlockLineHeight"
                                                               VerticalAlignment="Top"
                                                               ToolTipService.ToolTip="{Binding DisplayName}" />

                                                    <!-- Classification row: reserved even before a run so cards never reflow.
                                                         After a run the chip is a menu button (see ClassificationChip_OnClick):
                                                         pick another category, choose "不归类", or restore the AI suggestion.
                                                         The pill fill and leading icon follow the review state. -->
                                                    <Grid Grid.Row="2" Height="24">
                                                        <Button Click="ClassificationChip_OnClick"
                                                                IsEnabled="{Binding IsSelected}"
                                                                Height="24"
                                                                MinHeight="24"
                                                                Padding="0"
                                                                Background="Transparent"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="0"
                                                                CornerRadius="12"
                                                                HorizontalAlignment="Center"
                                                                MaxWidth="116"
                                                                ToolTipService.ToolTip="{Binding ClassificationToolTip}"
                                                                AutomationProperties.Name="更改分类"
                                                                Visibility="{Binding HasPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Grid Height="24">
                                                                <Border CornerRadius="12" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                                        Visibility="{Binding ShowsAiLabel, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <Border CornerRadius="12" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                                                        Visibility="{Binding IsManuallyLabeled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <Border CornerRadius="12" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                                        Visibility="{Binding IsExcluded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <Border CornerRadius="12" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                                        Visibility="{Binding IsUncertain, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <Grid Padding="9,0,7,0" ColumnSpacing="4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <lucide:LucideIcon Icon="Check" FontSize="11" VerticalAlignment="Center"
                                                                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                                                       Visibility="{Binding ShowsAiLabel, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    <lucide:LucideIcon Icon="PenLine" FontSize="11" VerticalAlignment="Center"
                                                                                       Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                                                                       Visibility="{Binding IsManuallyLabeled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    <lucide:LucideIcon Icon="Ban" FontSize="11" VerticalAlignment="Center"
                                                                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                                                                       Visibility="{Binding IsExcluded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    <lucide:LucideIcon Icon="CircleAlert" FontSize="11" VerticalAlignment="Center"
                                                                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                                                       Visibility="{Binding IsUncertain, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding ClassificationText}"
                                                                               FontSize="11.5"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               VerticalAlignment="Center" />
                                                                    <lucide:LucideIcon Grid.Column="2" Icon="ChevronDown" FontSize="10" VerticalAlignment="Center"
                                                                                       Foreground="{ThemeResource SecondaryTextBrush}" />
                                                                </Grid>
                                                            </Grid>
                                                        </Button>
                                                    </Grid>
                                                </Grid>

                                                <!-- Selection checkbox: compact, top-right, clear of the centered icon -->
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Width="20"
                                                          Height="20"
                                                          MinWidth="20"
                                                          MinHeight="20"
                                                          Padding="0"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Top"
                                                          AutomationProperties.Name="选择桌面图标" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsWorkspaceEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <lucide:LucideIcon Icon="Inbox" FontSize="32" HorizontalAlignment="Center" />
                            <TextBlock Text="当前没有位于桌面的可整理图标" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding HasNoFilterMatches, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <lucide:LucideIcon Icon="SearchX" FontSize="32" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding NoFilterMatchesText}" Style="{StaticResource SecondaryBodyStyle}" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource SectionCardStyle}"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Margin="14,12,14,10" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="15" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <lucide:LucideIcon Icon="Sparkles" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="1">
                                <TextBlock Text="CrabDesk AI" FontWeight="SemiBold" />
                                <TextBlock Text="桌面分类助手" Style="{StaticResource SecondaryBodyStyle}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="SettingsButton"
                                Grid.Column="1"
                                Click="SettingsButton_OnClick"
                                Padding="8"
                                MinHeight="32"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="AI 设置"
                                AutomationProperties.Name="打开 AI 设置">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <lucide:LucideIcon Icon="Settings" FontSize="16" />
                                <TextBlock Text="设置" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Conversation: agent activity feed -->
                    <ListView x:Name="ConversationList"
                              Grid.Row="1"
                              ItemsSource="{Binding Conversation}"
                              SelectionMode="None"
                              Padding="10,4,10,6">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <!-- System message -->
                                    <StackPanel Spacing="2"
                                                HorizontalAlignment="Center"
                                                Visibility="{Binding IsSystem, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Text}"
                                                   Style="{StaticResource SecondaryBodyStyle}"
                                                   FontSize="12"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding TimeText}"
                                                   Style="{StaticResource SecondaryBodyStyle}"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- User message -->
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Visibility="{Binding IsUser, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border MaxWidth="330"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="10"
                                                Padding="10,6">
                                            <TextBlock Text="{Binding Text}"
                                                       Foreground="White"
                                                       FontSize="13"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Assistant message: full-width agent activity feed -->
                                    <StackPanel Spacing="9"
                                                HorizontalAlignment="Stretch"
                                                Visibility="{Binding IsAssistant, Converter={StaticResource BooleanToVisibilityConverter}}">

                                        <!-- Identity row -->
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                <Border Width="24" Height="24" CornerRadius="12" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                                    <lucide:LucideIcon Icon="Sparkles" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="CrabDesk AI" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding TimeText}"
                                                       Style="{StaticResource SecondaryBodyStyle}"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0,0,0" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <lucide:LucideIcon Icon="CircleAlert" FontSize="13"
                                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                   Visibility="{Binding IsError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <ProgressRing Width="13" Height="13" IsActive="{Binding IsRunning}"
                                                              Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Feed body: aligned under the agent identity -->
                                        <StackPanel Spacing="8" Margin="31,0,4,0">

                                            <!-- Task narration -->
                                            <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" />

                                            <!-- Thinking process -->
                                            <Expander IsExpanded="{Binding IsThinkingExpanded, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Stretch"
                                                      Visibility="{Binding ThinkingText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                                <Expander.Header>
                                                    <Grid ColumnSpacing="8" HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <lucide:LucideIcon Icon="Brain" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="思考过程" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding ThinkingStatsText}" Style="{StaticResource SecondaryBodyStyle}" FontSize="10"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding ThinkingStatsText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Command="{Binding DataContext.CopyMessageThinkingCommand, ElementName=RootPage}"
                                                                CommandParameter="{Binding}"
                                                                Padding="5,2" MinHeight="24" Height="24"
                                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                                                ToolTipService.ToolTip="复制思考过程" AutomationProperties.Name="复制思考过程">
                                                            <lucide:LucideIcon Icon="Copy" FontSize="11" />
                                                        </Button>
                                                    </Grid>
                                                </Expander.Header>
                                                <TextBox Text="{Binding ThinkingText}"
                                                         IsReadOnly="True"
                                                         AcceptsReturn="True"
                                                         TextWrapping="NoWrap"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         FontFamily="Consolas"
                                                         FontSize="11"
                                                         MinHeight="60"
                                                         MaxHeight="200"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Margin="0,4,0,0"
                                                         TextChanged="MessageTextBox_OnTextChanged" />
                                            </Expander>

                                            <!-- Tool calls (web search, etc.) -->
                                            <ItemsControl ItemsSource="{Binding ToolCalls}"
                                                          Visibility="{Binding HasToolCalls, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="7" Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="16" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <lucide:LucideIcon Icon="{Binding Icon}" FontSize="12" VerticalAlignment="Center"
                                                                               Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Detail}" FontSize="10" TextTrimming="CharacterEllipsis" Style="{StaticResource SecondaryBodyStyle}" />
                                                            </StackPanel>
                                                            <ProgressRing Grid.Column="2" Width="11" Height="11" IsActive="{Binding IsRunning}"
                                                                          VerticalAlignment="Center"
                                                                          Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding TimeText}" FontSize="10" Style="{StaticResource SecondaryBodyStyle}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Classification timeline -->
                                            <StackPanel Spacing="5"
                                                        Visibility="{Binding HasClassificationActivities, Converter={StaticResource BooleanToVisibilityConverter}}">

                                                <!-- Live: current step + a sliding window of the most recently updated rows.
                                                     The full trace lives in ClassificationActivities and is shown once finished. -->
                                                <StackPanel Spacing="5"
                                                            Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid ColumnSpacing="7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <ProgressRing Width="12" Height="12" IsActive="True" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding ClassificationActivitySummary}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding RecentClassificationActivities}"
                                                                  ItemTemplate="{StaticResource AiActivityRowTemplate}"
                                                                  Margin="5,0,0,0" />
                                                </StackPanel>

                                                <!-- Finished: the complete trace (every processed item) behind a toggle -->
                                                <StackPanel Spacing="5"
                                                            Visibility="{Binding IsRunning, Converter={StaticResource BooleanNegationToVisibilityConverter}}">
                                                    <Button Command="{Binding ToggleProcessCommand}"
                                                            Padding="6,3" MinHeight="26"
                                                            Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                                            HorizontalAlignment="Left"
                                                            ToolTipService.ToolTip="展开或收起分类过程"
                                                            AutomationProperties.Name="切换分类过程显示">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <lucide:LucideIcon Icon="ChevronDown" FontSize="12" VerticalAlignment="Center"
                                                                               Visibility="{Binding IsProcessExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <lucide:LucideIcon Icon="ChevronRight" FontSize="12" VerticalAlignment="Center"
                                                                               Visibility="{Binding IsProcessExpanded, Converter={StaticResource BooleanNegationToVisibilityConverter}}" />
                                                            <TextBlock Text="过程轨迹" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding ClassificationActivitySummary}" FontSize="10" Style="{StaticResource SecondaryBodyStyle}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <!-- Capped to roughly the six rows the live view shows; longer traces scroll
                                                         inside instead of stretching the message to 65 rows. -->
                                                    <ScrollViewer MaxHeight="132"
                                                                  Margin="5,2,0,0"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled"
                                                                  Visibility="{Binding IsProcessExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <ItemsControl ItemsSource="{Binding ClassificationActivities}"
                                                                      ItemTemplate="{StaticResource AiActivityRowTemplate}"
                                                                      Margin="0,0,8,0" />
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Success mark -->
                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                        Visibility="{Binding ShowSuccessMark, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <lucide:LucideIcon Icon="CircleCheck" FontSize="13"
                                                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                                  VerticalAlignment="Center" />
                                                <TextBlock Text="分类完成" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Results: category rows with item chips -->
                                            <ItemsControl ItemsSource="{Binding ResultGroups}"
                                                          Visibility="{Binding HasResultGroups, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Spacing="5" Margin="0,0,0,8">
                                                            <Grid ColumnSpacing="6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                    <lucide:LucideIcon Icon="Folder" FontSize="12"
                                                                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                                                       VerticalAlignment="Center"
                                                                                       Visibility="{Binding IsUncertainGroup, Converter={StaticResource BooleanNegationToVisibilityConverter}}" />
                                                                    <lucide:LucideIcon Icon="CircleAlert" FontSize="12"
                                                                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                                                       VerticalAlignment="Center"
                                                                                       Visibility="{Binding IsUncertainGroup, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    <TextBlock Text="{Binding CategoryName}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="10"
                                                                           Style="{StaticResource SecondaryBodyStyle}" VerticalAlignment="Center" />
                                                            </Grid>
                                                            <ItemsRepeater ItemsSource="{Binding ItemNames}" Margin="4,0,0,0">
                                                                <ItemsRepeater.Layout>
                                                                    <lucide:TagWrapLayout />
                                                                </ItemsRepeater.Layout>
                                                                <ItemsRepeater.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                                                BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="6"
                                                                                Padding="7,3"
                                                                                MaxWidth="150">
                                                                            <TextBlock Text="{Binding}"
                                                                                       FontSize="11"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       VerticalAlignment="Center" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsRepeater.ItemTemplate>
                                                            </ItemsRepeater>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Micro meta -->
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding TransportText}"
                                                           Style="{StaticResource SecondaryBodyStyle}"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding TransportText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                                <TextBlock Text="{Binding ParsedText}"
                                                           Style="{StaticResource SecondaryBodyStyle}"
                                                           FontSize="10"
                                                           Visibility="{Binding ParsedText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                                <TextBlock Text="{Binding MetricsText}"
                                                           Style="{StaticResource SecondaryBodyStyle}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding MetricsText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                            </StackPanel>

                                            <!-- Result JSON -->
                                            <Expander HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Stretch"
                                                      Visibility="{Binding ResultJsonText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                                <Expander.Header>
                                                    <Grid ColumnSpacing="8" HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <lucide:LucideIcon Icon="Braces" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="分类结果 JSON" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Command="{Binding DataContext.CopyMessageResultJsonCommand, ElementName=RootPage}"
                                                                CommandParameter="{Binding}"
                                                                Padding="5,2" MinHeight="24" Height="24"
                                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                                                ToolTipService.ToolTip="复制 JSON" AutomationProperties.Name="复制分类结果 JSON">
                                                            <lucide:LucideIcon Icon="Copy" FontSize="11" />
                                                        </Button>
                                                    </Grid>
                                                </Expander.Header>
                                                <TextBox Text="{Binding ResultJsonText}"
                                                         IsReadOnly="True"
                                                         AcceptsReturn="True"
                                                         TextWrapping="NoWrap"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         FontFamily="Consolas"
                                                         FontSize="11"
                                                         MinHeight="60"
                                                         MaxHeight="240"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Margin="0,4,0,0"
                                                         TextChanged="MessageTextBox_OnTextChanged" />
                                            </Expander>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Composer -->
                    <Border Grid.Row="2"
                            Padding="12,10,12,12"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <ProgressBar IsIndeterminate="{Binding IsProgressIndeterminate}"
                                         Maximum="100"
                                         Value="{Binding ProgressValue}"
                                         Visibility="{Binding HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="{Binding Status}"
                                       Style="{StaticResource SecondaryBodyStyle}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Before a preview the run button is the primary action; once a
                                     preview exists "确认应用" takes the accent and the run button
                                     becomes "重新分类". The stop button only exists while running. -->
                                <Button Command="{Binding ClassifyCommand}"
                                        Style="{Binding HasPreview, Converter={StaticResource PrimaryActionStyleConverter}, ConverterParameter=invert}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        ToolTipService.ToolTip="对当前勾选的图标运行 AI 分类">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <lucide:LucideIcon Icon="Sparkles" FontSize="15" />
                                        <TextBlock Text="{Binding ClassifyButtonText}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Command="{Binding ApplyCommand}"
                                        IsEnabled="{Binding CanApplyPreview}"
                                        Style="{Binding HasPreview, Converter={StaticResource PrimaryActionStyleConverter}}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        ToolTipService.ToolTip="按当前结果创建盒子并归类；不归类和未勾选的图标保留在桌面">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <lucide:LucideIcon Icon="Check" FontSize="14" />
                                        <TextBlock Text="确认应用" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2"
                                        Margin="8,0,0,0"
                                        Command="{Binding CancelCommand}"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        ToolTipService.ToolTip="终止本次 AI 分类"
                                        AutomationProperties.Name="终止 AI 分类">
                                    <lucide:LucideIcon Icon="Square" FontSize="14" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>
