<Page
    x:Class="CrabDesk.WinUI.Views.OrganizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.WinUI">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  IsTabStop="True">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="12" HorizontalAlignment="Stretch">
            <Border Style="{StaticResource SectionCardStyle}" Padding="16,0,16,16">
                <StackPanel Spacing="10">
                    <Grid Style="{StaticResource SettingRowGridStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="启用自动整理" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" Style="{StaticResource CompactToggleSwitchStyle}" IsOn="{Binding OrganizationEnabled, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <CheckBox Content="启动时运行" IsChecked="{Binding RunOnStartup, Mode=TwoWay}" />
                            <CheckBox Content="桌面变化时运行" IsChecked="{Binding RunRealtime, Mode=TwoWay}" />
                            <CheckBox Content="重新分配已有项目" IsChecked="{Binding ReassignExisting, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ConflictText}"
                                   Style="{StaticResource SecondaryBodyStyle}"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <CommandBar DefaultLabelPosition="Collapsed" Background="Transparent">
                <AppBarButton Label="新建规则" Command="{Binding AddRuleCommand}" ToolTipService.ToolTip="新建规则"><AppBarButton.Icon><icons:FluentIcon Icon="FilterAdd" /></AppBarButton.Icon></AppBarButton>
                <AppBarButton Label="编辑规则" Command="{Binding EditRuleCommand}" ToolTipService.ToolTip="编辑规则"><AppBarButton.Icon><icons:FluentIcon Icon="Edit" /></AppBarButton.Icon></AppBarButton>
                <AppBarButton Label="复制规则" Command="{Binding DuplicateRuleCommand}" ToolTipService.ToolTip="复制规则"><AppBarButton.Icon><icons:FluentIcon Icon="DocumentCopy" /></AppBarButton.Icon></AppBarButton>
                <AppBarButton Label="上移" Command="{Binding MoveUpCommand}" ToolTipService.ToolTip="上移"><AppBarButton.Icon><icons:FluentIcon Icon="ArrowUp" /></AppBarButton.Icon></AppBarButton>
                <AppBarButton Label="下移" Command="{Binding MoveDownCommand}" ToolTipService.ToolTip="下移"><AppBarButton.Icon><icons:FluentIcon Icon="ArrowDown" /></AppBarButton.Icon></AppBarButton>
                <AppBarButton Label="删除" Command="{Binding DeleteRulesCommand}" ToolTipService.ToolTip="删除选中的规则"><AppBarButton.Icon><icons:FluentIcon Icon="Delete" /></AppBarButton.Icon></AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="预览" Command="{Binding PreviewCommand}" ToolTipService.ToolTip="预览本次整理将移动的项目"><AppBarButton.Icon><icons:FluentIcon Icon="Eye" /></AppBarButton.Icon></AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="安装默认规则" Command="{Binding InstallDefaultsCommand}" />
                </CommandBar.SecondaryCommands>
            </CommandBar>

            <ItemsRepeater ItemsSource="{Binding Rules}" AutomationProperties.Name="整理规则列表">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="2" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10,8" MinHeight="58" ColumnSpacing="14" Tapped="RuleRow_OnTapped">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Width="32"
                                      MinWidth="0"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Checked="RuleSelected_OnChanged"
                                      Unchecked="RuleSelected_OnChanged"
                                      AutomationProperties.Name="选择规则" />
                            <ToggleSwitch Grid.Column="1"
                                          Width="44"
                                          MinWidth="0"
                                          OnContent=""
                                          OffContent=""
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          IsOn="{Binding Enabled, Mode=OneWay}"
                                          Toggled="RuleEnabled_OnToggled"
                                          AutomationProperties.Name="启用规则" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CriteriaText}"
                                           Style="{StaticResource SecondaryBodyStyle}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="3"
                                        Orientation="Horizontal"
                                        Spacing="7"
                                        VerticalAlignment="Center">
                                <icons:FluentIcon Icon="ArrowRight"
                                                  FontSize="13"
                                                  Foreground="{ThemeResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding DestinationText}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Border Style="{StaticResource SectionCardStyle}"
                    Padding="16"
                    Visibility="{Binding IsPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <icons:FluentIcon Icon="Eye" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource AccentBrush}" />
                        <TextBlock Grid.Column="1" Text="整理预览" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Padding="6"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding ClosePreviewCommand}"
                                ToolTipService.ToolTip="关闭预览">
                            <icons:FluentIcon Icon="Dismiss" FontSize="14" />
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding PreviewSummaryText}" Style="{StaticResource SecondaryBodyStyle}" />
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsRepeater ItemsSource="{Binding PreviewSections}" AutomationProperties.Name="整理预览分组">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="12" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="4">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <Border Grid.Column="1"
                                                    Background="{ThemeResource SubtleBorderBrush}"
                                                    CornerRadius="8"
                                                    Padding="7,1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Count}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource SecondaryTextBrush}" />
                                            </Border>
                                        </Grid>
                                        <ItemsRepeater ItemsSource="{Binding Items}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="2" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Padding="8,6" ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding ItemName}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding MatchedByText}"
                                                                   Style="{StaticResource SecondaryBodyStyle}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <Grid ColumnSpacing="8" HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="重新预览" Command="{Binding PreviewCommand}" />
                        <Button Grid.Column="1" Content="应用整理" Style="{StaticResource AccentButtonStyle}" Command="{Binding ApplyPreviewCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ResultText}" VerticalAlignment="Center" Foreground="{ThemeResource AccentBrush}" />
                <Button Grid.Column="1" Content="撤销" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" />
                <Button Grid.Column="2" Content="立即整理" Command="{Binding ApplyCommand}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
