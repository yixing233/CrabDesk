<Page
    x:Class="CrabDesk.WinUI.Views.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CrabDesk.WinUI.Controls"
    xmlns:lucide="using:CrabDesk.WinUI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <Grid Padding="{StaticResource PagePadding}" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}" Padding="16,0" Margin="0,0,0,20">
            <StackPanel>
                <Border Style="{StaticResource SettingRowStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="备份位置" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding BackupDirectory}" Style="{StaticResource SecondaryBodyStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding ChangeBackupDirectoryCommand}"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="选择备份文件夹"
                                AutomationProperties.Name="更改备份位置">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <lucide:LucideIcon Icon="FolderOpen" />
                                <TextBlock Text="更改位置" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingRowStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="保留周期" FontWeight="SemiBold" />
                            <TextBlock Text="自动清理超过保留天数的历史备份" Style="{StaticResource SecondaryBodyStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <NumberBox Width="{StaticResource NumericSettingsControlWidth}" Minimum="1" Maximum="365" SpinButtonPlacementMode="Inline"
                                       Value="{Binding RetentionDays, Mode=TwoWay}" AutomationProperties.Name="备份保留天数" />
                            <TextBlock Text="天" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingRowStyle}" BorderThickness="0">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="自动备份" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" Style="{StaticResource CompactToggleSwitchStyle}" IsOn="{Binding DailyBackup, Mode=TwoWay}"
                                      VerticalAlignment="Center" AutomationProperties.Name="自动备份" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingRowStyle}" BorderThickness="0">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="自动备份间隔" FontWeight="SemiBold" />
                            <TextBlock Text="最小间隔为 1 小时" Style="{StaticResource SecondaryBodyStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <NumberBox Width="{StaticResource NumericSettingsControlWidth}" Minimum="1" Maximum="8760" SmallChange="1" SpinButtonPlacementMode="Inline"
                                       IsEnabled="{Binding DailyBackup}" Value="{Binding BackupIntervalHours, Mode=TwoWay}"
                                       AutomationProperties.Name="自动备份间隔小时数" />
                            <TextBlock Text="小时" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="12" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="备份记录" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" Margin="0" />
            <CommandBar Grid.Column="1" DefaultLabelPosition="Collapsed" Background="Transparent" HorizontalAlignment="Right">
                <AppBarButton Label="创建备份" Command="{Binding CreateCommand}" ToolTipService.ToolTip="创建备份"><AppBarButton.Icon><lucide:LucideIcon Icon="Plus" /></AppBarButton.Icon></AppBarButton>
                <AppBarButton Label="导出布局" Command="{Binding ExportCommand}" ToolTipService.ToolTip="导出布局"><AppBarButton.Icon><lucide:LucideIcon Icon="Upload" /></AppBarButton.Icon></AppBarButton>
                <AppBarButton Label="导入布局" Command="{Binding ImportCommand}" ToolTipService.ToolTip="导入布局"><AppBarButton.Icon><lucide:LucideIcon Icon="Download" /></AppBarButton.Icon></AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="酷呆迁移" ToolTipService.ToolTip="从酷呆桌面 (Coodesker) 迁移布局">
                    <AppBarButton.Icon><lucide:LucideIcon Icon="FolderSync" /></AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="一键从本机酷呆桌面覆盖迁移" Command="{Binding MigrateFromLocalCoodeskerCommand}">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="导入酷呆桌面备份文件 (.backup)..." Command="{Binding ImportCoodeskerBackupCommand}">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="预览" Command="{Binding PreviewCommand}" ToolTipService.ToolTip="预览所选备份"><AppBarButton.Icon><lucide:LucideIcon Icon="Eye" /></AppBarButton.Icon></AppBarButton>
                <AppBarButton Label="恢复" Command="{Binding RestoreCommand}" ToolTipService.ToolTip="恢复所选备份"><AppBarButton.Icon><lucide:LucideIcon Icon="RotateCcw" /></AppBarButton.Icon></AppBarButton>
                <AppBarButton Label="删除" Command="{Binding DeleteCommand}" ToolTipService.ToolTip="删除所选备份"><AppBarButton.Icon><lucide:LucideIcon Icon="Trash2" /></AppBarButton.Icon></AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="刷新" Command="{Binding RefreshCommand}" />
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <Grid Grid.Row="2">
            <ListView ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup, Mode=TwoWay}"
                      SelectionMode="Single" Visibility="{Binding HasBackups, Converter={StaticResource BooleanToVisibilityConverter}}"
                      HorizontalContentAlignment="Stretch"
                      AutomationProperties.Name="布局备份列表">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="16,12" MinHeight="124" ColumnSpacing="20"
                              DoubleTapped="BackupItem_OnDoubleTapped">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="176" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <controls:DesktopSnapshotView Width="176"
                                                          Height="100"
                                                          Snapshot="{Binding Snapshot}"
                                                          DesktopPreviewPath="{Binding DesktopPreviewPath}"
                                                          AutomationProperties.Name="备份桌面快照" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="7">
                                <TextBlock Text="{Binding CreatedAtText}"
                                           FontFamily="Segoe UI Variable Text"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding FileName}"
                                           Style="{StaticResource SecondaryBodyStyle}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{Binding Path}" />
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <lucide:LucideIcon Icon="Box" FontSize="13" Foreground="{ThemeResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding BoxCount}" Style="{StaticResource SecondaryBodyStyle}" />
                                        <TextBlock Text="个盒子" Style="{StaticResource SecondaryBodyStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <lucide:LucideIcon Icon="ListTree" FontSize="13" Foreground="{ThemeResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding RuleCount}" Style="{StaticResource SecondaryBodyStyle}" />
                                        <TextBlock Text="条规则" Style="{StaticResource SecondaryBodyStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <lucide:LucideIcon Icon="Monitor" FontSize="13" Foreground="{ThemeResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding MonitorCount}" Style="{StaticResource SecondaryBodyStyle}" />
                                        <TextBlock Text="块屏幕" Style="{StaticResource SecondaryBodyStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Border Style="{StaticResource SectionCardStyle}" MinHeight="150"
                    Visibility="{Binding HasNoBackups, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <lucide:LucideIcon Icon="Archive" FontSize="28" Foreground="{ThemeResource SecondaryTextBrush}" />
                    <TextBlock Text="还没有布局备份" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="创建备份后，可随时恢复当前桌面布局" Style="{StaticResource SecondaryBodyStyle}" />
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </ScrollViewer>
</Page>
