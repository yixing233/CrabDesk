<Page
    x:Class="CrabDesk.WinUI.Views.DesktopBoxesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CrabDesk.WinUI.Views"
    NavigationCacheMode="Enabled">
    <TabView TabWidthMode="SizeToContent"
             IsAddTabButtonVisible="False"
             CanReorderTabs="False"
             CanDragTabs="False">
        <TabViewItem Header="管理盒子" IsClosable="False">
            <views:BoxesPage />
        </TabViewItem>
        <TabViewItem Header="外观与图标" IsClosable="False">
            <views:AppearancePage />
        </TabViewItem>
    </TabView>
</Page>
