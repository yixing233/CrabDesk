<Window
    x:Class="CrabDesk.WinUI.Windows.DesktopConfirmWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Border
            x:Name="SurfaceBorder"
            CornerRadius="8">
            <Grid Margin="26,24,26,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="IconBadge"
                    Width="46"
                    Height="46"
                    Margin="0,0,16,0"
                    VerticalAlignment="Top"
                    Grid.RowSpan="2">
                    <Ellipse x:Name="BadgeFill" />
                    <FontIcon
                        x:Name="BadgeGlyph"
                        Glyph="&#xE74D;"
                        FontSize="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Grid>

                <TextBlock
                    x:Name="TitleText"
                    Grid.Column="1"
                    FontSize="19"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center"
                    Margin="0,2,0,0" />

                <TextBlock
                    x:Name="MessageText"
                    Grid.Column="1"
                    Grid.Row="1"
                    FontSize="13"
                    LineHeight="20"
                    TextWrapping="Wrap"
                    Margin="0,7,0,0" />

                <StackPanel
                    x:Name="Actions"
                    Grid.Column="1"
                    Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,18,0,0">
                    <Button
                        x:Name="CancelButton"
                        Content="取消"
                        MinWidth="88"
                        Height="34"
                        Padding="18,0,18,0"
                        FontSize="13"
                        FontWeight="SemiBold"
                        CornerRadius="6"
                        BorderThickness="1"
                        Click="OnCancelClick" />
                    <Button
                        x:Name="PrimaryButton"
                        MinWidth="96"
                        Height="34"
                        Padding="18,0,18,0"
                        FontSize="13"
                        FontWeight="SemiBold"
                        CornerRadius="6"
                        BorderThickness="1"
                        Click="OnPrimaryClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
